# ---- Chaves de API (obrigatórias) ----
# Chave da OpenAI (https://platform.openai.com/api-keys) — sumarização das
# trends, roteiro e descrição das mídias (visão)
OPENAI_API_KEY=

# Chave da ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — narração
ELEVENLABS_API_KEY=

# Chave do Firecrawl (https://firecrawl.dev) — busca das notícias que
# enriquecem a trend escolhida (Search API com sources=["news"]).
FIRECRAWL_API_KEY=

# X API oficial (pay-per-use, ~US$ 0,005 por post lido). Consumer Key + Secret
# do app em https://developer.x.com — usados para coletar os posts das contas
# acompanhadas e baixar os clipes de vídeo dos posts originais da trend.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# ---- Fontes ----
# Opcional. A coleta usa a lista fixa CONTAS_PADRAO em pipeline/config.py:
# 200 contas (OSINT e monitoramento de conflito primeiro, porque são elas que
# publicam CLIPE; depois governos, forças armadas, think tanks, imprensa
# internacional, monitores de sismo e de tempo extremo, agências de alerta,
# polícias e Ministério Público, e Brasil), todas verificadas contra
# /2/users/by da X API. Se preenchido, usa somente estas contas (separadas
# por vírgula, sem @), ex.: sentdefender,Faytuks,USGS
X_ACCOUNTS=

# Teto de posts lidos por execução (a X API cobra por post lido;
# 60 posts ≈ US$ 0,30)
X_MAX_POSTS=200
# Leituras extras de uma varredura `has:videos` sobre as MESMAS contas. A
# coleta acima ordena por relevância e NÃO prefere vídeo, então o post com
# clipe — o único material que o formato consegue usar — perde vaga para um
# post de TEXTO sobre o mesmo fato. Nenhuma fonte nova entra por aqui.
#
# LIGADA nos dois formatos deste canal (no repo de origem ela era 0 no Short).
# A primeira execução real, em 2026-08-10, provou a necessidade: 227 posts
# coletados, 73 com clipe nativo, e ainda assim as três candidatas chegaram à
# auditoria com UM clipe cada — sem folga, um único veto zerava a pauta e a
# execução abortava. Custa ~US$ 0,30 por execução. 0 desliga.
X_MAX_POSTS_VIDEO=60
# Busca ABERTA por clipes do assunto, fora das contas do canal. Só o
# --long-take usa: é ele que precisa de vários clipes do MESMO fato. As fontes
# aqui NÃO são curadas (conta desconhecida, telejornal reempacotado, material
# enganoso) e quem filtra é a auditoria de visão, que julga pertinência e não
# veracidade — por isso o orçamento é modesto. 0 desliga.
X_MAX_POSTS_BUSCA=30
# Leituras da TIMELINE das contas (/2/users/:id/tweets). A busca acima ordena
# por RELEVÂNCIA, e relevância no X é engajamento acumulado — o post publicado
# há vinte minutos (o vazamento, o comunicado, o número que acabou de sair)
# ainda não tem engajamento e por isso é justamente o que ela deixa de fora. A
# timeline é cronológica e não faz esse juízo. Custa UMA requisição por conta,
# então o orçamento é dividido em "posts por conta" e cobre um subconjunto
# rotativo das contas por execução (um cursor circular, .rotacao_timeline,
# garante que todas passem ao longo do dia). 0 desliga.
X_MAX_POSTS_TIMELINE=60

# Janela de coleta em horas (posts mais recentes que isso). Alargar NÃO custa
# mais na X API: o teto de leitura é o X_MAX_POSTS acima, e a janela só decide
# de que intervalo saem esses posts (a busca ordena por relevância).
# Case a janela com a CADÊNCIA do cron, não com o formato: um Short que roda de
# 4 em 4 horas quer 4, senão execuções seguidas pegam os mesmos posts. Já o
# --long-take roda 3x por semana e precisa de UM acontecimento com vários posts
# de vídeo nativo — com 4h ele quase nunca acha material para 8 clipes, então
# em produção os crons longos rodam com 48 (dois dias).
# No cron deste canal (3 execuções por dia, de 6 em 6 horas úteis) o valor de
# produção é 8.
JANELA_HORAS=24

# Quantas trends mais faladas do X coletar para escolher a do vídeo
NUM_TRENDS=10
# Quantas notícias (Firecrawl news) buscar para enriquecer a trend escolhida
NUM_NOTICIAS=6

# ---- Modelos (opcionais, valores padrão abaixo) ----
TEXT_MODEL=gpt-5.6-luna
# Geração das figuras sobrepostas (gráficos, tabelas, infográficos, cartazes)
IMAGEM_MODEL=gpt-image-2
# low | medium | high | auto. "medium" é o piso para figura com texto: em "low"
# o rótulo sai borrado, e rótulo borrado num gráfico não paga a chamada.
IMAGEM_QUALIDADE=medium

# ---- Narração (ElevenLabs) ----
ELEVENLABS_VOICE_ID=czvzJwIVS2asEKnthV40
# Voz usada quando rodar com -usa (público americano)
ELEVENLABS_VOICE_ID_USA=POPWFdpTM8Mn2ZQEagyQ
# eleven_v3 suporta audio tags ([excited], [whispers] etc.) no roteiro
ELEVENLABS_MODEL=eleven_v3

# ---- Vídeo ----
# Duração-alvo da narração em segundos; a duração final do vídeo segue o áudio.
# 25s desde 2026-08-09 (pedido do usuário; vinha de 60).
# PISO DURO de 21s: Short com narração mais curta que isso NÃO é publicado (a
# execução aborta depois da narração). Valor abaixo de 21 é recusado no
# carregamento da configuração.
VIDEO_DURACAO=25
# Velocidade da narração — e, com ela, o ritmo do vídeo inteiro (cortes,
# legendas e sobreposições saem do alinhamento, que é reescalado junto).
# 1.0 = normal. O SHORT roda acelerado (ritmo é o que segura o feed); o formato
# longo roda em 1.0, porque análise em fala apressada não é acompanhável.
# O orçamento de palavras do roteiro é multiplicado por este valor: narração
# mais rápida cabe mais palavras no mesmo tempo de tela.
VIDEO_VELOCIDADE=1.25
# Resolução do vídeo. Padrão: vertical 9:16 para shorts/reels.
VIDEO_LARGURA=1080
VIDEO_ALTURA=1920

# ---- Material visual e auditoria ----
# Posts da trend consultados no lookup de mídias (≈ US$ 0,005 cada). Precisa
# ser folgado: a auditoria reprova material de telejornal e clipe fora do
# assunto, e sem pool a reprovação só teria como saída abortar o vídeo.
MAX_POSTS_MIDIA=12
# Clipes baixados ALÉM dos que entram na montagem, como folga da auditoria
POOL_EXTRA_CLIPES=3
# Fotos dos posts baixadas para as cartelas (0 desliga)
MAX_FOTOS=4
# Cartelas de imagem nos momentos-chave (0 desliga). Desde 2026-08-09 cada uma
# TOMA A TELA do celular pelo arrasto da mão, no lugar do clipe — não é mais um
# cartão sobreposto. Com o Short em 25 segundos, some com MAX_FIGURAS antes de
# subir: cada imagem tira ~4s de clipe da tela.
MAX_CARTELAS=1
# Figuras GERADAS pelo gpt-image-2 (gráfico, tabela, infográfico, diagrama ou
# cartaz) desenhadas a partir dos números que a narração diz, ancoradas na
# citação literal do trecho. Entram pelo mesmo arrasto das cartelas. Cada
# figura é uma chamada paga de geração de imagem. 0 desliga.
# São a ÚNICA fonte de "big number" na tela: os infográficos animados que o
# ffmpeg montava a partir de PNGs do Pillow foram removidos em 2026-08-04.
MAX_FIGURAS=1
# VETO A TEXTO NA TELA (1 liga, 0 desliga). O clipe do X entra como fundo de um
# vídeo que já tem legendas grandes queimadas, cartelas e figuras por cima —
# um clipe que também é texto empilha duas leituras concorrentes e o
# espectador não faz nenhuma. Com o veto ligado, clipe TOMADO por texto (e,
# mais ainda, por texto PARADO: slide, cartaz, print) sai da montagem, A NÃO
# SER que aquele texto seja o assunto que a narração descreve — o post citado,
# a tela do produto, o número falado. Quem mede o texto é a visão
# (densidade + se está parado); quem diz se ele é o assunto é o auditor, que
# lê a narração. Desligar aceita de volta o fundo de slide atrás das legendas.
VETO_TEXTO_DENSO=1
# VETO A CLIPE PARADO E A GENTE FALANDO (1 liga, 0 desliga), 2026-08-09. Dois
# casos saem da montagem: o clipe ESTÁTICO (o mesmo quadro do começo ao fim —
# foto com áudio, slide, tela congelada) e o clipe de PESSOA FALANDO para a
# câmera (entrevista, podcast, coletiva, depoimento, âncora). Os dois falham
# pelo mesmo motivo: o vídeo é montado sobre movimento, e um quadro que não muda
# ou um busto que só mexe a boca ocupam a tela sem mostrar o fato. É veto duro,
# sem exceção de contexto e sem exceção de formato — no formato longo ele passa
# na frente da marcação de representação visual, então telejornal só entra
# quando é VT com imagens do fato, não âncora em quadro. Vale só para os
# CLIPES: as cartelas são imagens paradas por definição e passam por fora.
VETO_CLIPE_PARADO=1

# ---- Formato longo (python main.py --long-take) ----
# Vídeo de análise em 16:9, de 120 a 150 segundos, sem legendas, cobrindo de 3
# a 5 TÓPICOS, para os dois canais (combina com -usa). Estas variáveis só valem
# nessa execução — as de cima continuam mandando no formato curto, então dá
# para ter os dois crons no Render com o mesmo .env.
# Duração-alvo da narração (obrigatoriamente entre 120 e 150). O piso de 120s é
# DURO: narração mais curta que isso aborta a execução sem publicar.
LONG_DURACAO=135
LONG_LARGURA=1920
LONG_ALTURA=1080
# Clipes de vídeo do X usados na montagem (cada mídia lida ≈ US$ 0,005)
LONG_MAX_CLIPES=8
# Posts da trend consultados para achar esses clipes (≈ US$ 0,005 cada)
LONG_MAX_POSTS_MIDIA=16
# Notícias (Firecrawl news) que embasam a análise
LONG_NUM_NOTICIAS=10
# Cartelas de imagem sobrepostas e fotos baixadas para alimentá-las
LONG_MAX_CARTELAS=4
LONG_MAX_FOTOS=6
# Figuras geradas pelo gpt-image-2 (o dobro do Short: o dobro de tempo de tela)
LONG_MAX_FIGURAS=4
# Velocidade da narração no formato longo: NORMAL, por decisão editorial.
LONG_VELOCIDADE=1.0

# ---- YouTube (publicação automática via Data API v3) ----
# Credenciais OAuth (Google Cloud Console > Credentials > OAuth client ID,
# tipo "Desktop app"). A publicação roda sempre, independente da flag -usa.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Canal @NoCrazyWarPlease (português) — gerado uma vez com:
#   python main.py --auth-youtube
# ATENÇÃO: na tela de consentimento do Google, escolha a conta de marca do
# canal NoCrazyWarPlease. O client OAuth é compartilhado com os outros
# canais, então selecionar o canal errado publica geopolítica no canal errado.
YOUTUBE_REFRESH_TOKEN=
# Reservado para um eventual canal irmão em inglês (-usa). O código continua
# suportando os dois idiomas; hoje só o canal português existe.
YOUTUBE_REFRESH_TOKEN_USA=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# Categoria do YouTube (25 = News & Politics, a do canal)
YOUTUBE_CATEGORY_ID=25

# ---- SEO e GEO (panorama do dia) ----
# Antes de escrever o roteiro, o pipeline pergunta à YouTube Data API que
# vídeos OUTROS canais publicaram sobre o mesmo assunto nas últimas
# JANELA_HORAS: títulos, views por hora e as TAGS que eles usaram. Esse
# panorama alimenta o título, a descrição, as tags do vídeo e o texto da capa —
# é a única leitura do pipeline sobre a disputa de FORA do canal (os últimos
# publicados e os campeões de retenção só enxergam o próprio público).
#
# CUSTO: uma busca por execução. Ela NÃO gasta da cota de 10.000 unidades/dia
# do projeto (que é onde o upload consome 1.600) — cai no balde separado de
# "Search Queries", com teto de 100 buscas/dia. O videos.list que completa os
# dados custa 1 unidade.
#
# Falha aqui só avisa: sem panorama os metadados voltam a ser calibrados só
# pelo histórico do canal, que é como o pipeline funcionava até 2026-08-07.
# 1 liga, 0 desliga.
SEO_PANORAMA=1
# Vídeos do dia lidos por execução (teto da API: 50). Acima de ~20 o bloco vira
# ruído no prompt e o modelo começa a colar termo de outro assunto.
SEO_MAX_VIDEOS=20

# ---- TikTok via Zernio (publicação secundária) ----
# O MESMO vídeo que vai para o YouTube é publicado no TikTok na mesma execução:
# nada é gerado de novo, então o custo adicional é ZERO. Vale só para o canal
# BRASILEIRO — a conta é brasileira e idioma é regra de canal, então numa
# execução com -usa (narração em inglês) a publicação não acontece.
#
# POR QUE PELO ZERNIO E NÃO DIRETO NA API DO TIKTOK: o TikTok só libera post
# PÚBLICO para app que passou pela auditoria dele, e a auditoria exige site,
# política de privacidade, ícone e vídeo demo de uma interface que este
# pipeline não tem. O Zernio já é um cliente auditado — a conta é conectada lá
# por OAuth e a publicação sai pública. No fim da linha é a mesma API oficial.
#
# 1 liga, 0 desliga. NESTE CANAL fica 0: não há conta de TikTok da marca, e
# ligar postaria os vídeos de geopolítica na conta pessoal de outro canal.
TIKTOK_PUBLICAR=0
# Chave da API em https://zernio.com (formato sk_ + 64 hex). A conta do TikTok
# precisa estar conectada na sua conta Zernio.
ZERNIO_API_KEY=
# Só é necessário se você tiver MAIS DE UMA conta de TikTok no Zernio; vazio
# faz o pipeline descobrir sozinho a única conectada.
ZERNIO_ACCOUNT_ID=
# Conta esperada, usada só em mensagens.
TIKTOK_USUARIO=lusrodri
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# Quais a conta aceita quem diz é o creator-info do Zernio (GET
# /v1/accounts/{id}/tiktok/creator-info). Use SELF_ONLY para testar sem
# publicar de verdade — o vídeo sobe visível só para você.
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# Rótulo de conteúdo gerado por IA (videoMadeWithAi). 1 por padrão: a narração
# é sintetizada (ElevenLabs) e as figuras da tela são desenhadas por modelo de
# imagem.
TIKTOK_AIGC=1
